<odoo>
    <record id="ncf_stock.view_stock_return_picking_form" model="ir.ui.view">
        <field name="name">mcf_stock view_stock_return_picking_form</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            <field name="location_id" position="before">
                <field invisible="1" name="out_refund"/>
                <field attrs="{'invisible':[('out_refund','=',True)]}" name="refund_action"/>
                <field attrs="{'required': ['|',('refund_action','=','none'), ('out_refund','=',True)]}" name="note"/>
                <field attrs="{'invisible':[('out_refund','=',True)]}" name="due_date"/>
                <field attrs="{'invisible':['|','|',('invoice_id','=',False),('refund_action','!=','invoice_refund'), ('out_refund','=',True)]}" name="invoice_id"/>
            </field>
        </field>
    </record>
</odoo>
