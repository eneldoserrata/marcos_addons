<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="currency_rates_account_invoice_form" model="ir.ui.view">
            <field name="name">Currency Rates account invoice form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/label" position="before">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" groups="base.group_multi_currency" icon="fa-money" name="update_currency_wizard" states="draft" string="Cambiar moneda" type="object"/>
                        <button class="oe_stat_button" groups="base.group_multi_currency" icon="fa-usd" name="update_rate_wizard" states="draft" string="Actualizar Tasa" type="object"/>
                    </div>
                </xpath>
                <xpath expr="//label[@groups='base.group_multi_currency']" position="replace"/>
                <xpath expr="//div[@groups='base.group_multi_currency']" position="replace">
                    <field invisible="1" name="company_currency_id"/>
                    <field class="oe_inline" name="currency_id" readonly="1"/>
                    <field class="oe_inline" name="rate"/>
                </xpath>
            </field>
        </record>
        <record id="currency_rates_supplier_account_invoice_form" model="ir.ui.view">
            <field name="name">Currency Rates supplier account invoice form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_supplier_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div" position="before">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" groups="base.group_multi_currency" icon="fa-money" name="update_currency_wizard" states="draft" string="Cambiar moneda" type="object"/>
                        <button class="oe_stat_button" groups="base.group_multi_currency" icon="fa-usd" name="update_rate_wizard" states="draft" string="Actualizar Tasa" type="object"/>
                    </div>
                    <xpath expr="//label[@groups='base.group_multi_currency']" position="replace"/>
                    <xpath expr="//div[@groups='base.group_multi_currency']" position="replace">
                        <field invisible="1" name="company_currency_id"/>
                        <field class="oe_inline" name="currency_id" readonly="1"/>
                    </xpath>
                </xpath>
            </field>
        </record>
    </data>
</openerp>
