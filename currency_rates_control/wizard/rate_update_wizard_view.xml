<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="update_rate_wizard_form" model="ir.ui.view">
            <field name="name">update_rate_wizard_form</field>
            <field name="model">update.rate.wizard</field>
            <field name="arch" type="xml">
                <form string="Actualización tasa">
                    <group>
                        <field name="update_method" widget="radio"/>
                    </group>
                    <group attrs="{'invisible': [('update_method','=','server')]}">
                        <field attrs="{'required': [('update_method','=','manual')]}" name="currency_id"/>
                        <field attrs="{'required': [('update_method','=','manual')]}" name="name"/>
                        <field attrs="{'required': [('update_method','=','manual')]}" name="rate"/>
                    </group>
                    <footer>
                        <button class="oe_highlight" name="update_rate" string="Actualizar" type="object"/>
                        <button special="cancel" string="Cancelar"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</openerp>
