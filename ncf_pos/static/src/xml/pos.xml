<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-extend="ClientDetailsEdit">
        <t t-jquery=".detail.client-name" t-operation="replace">
            <div class="client-detail">
                <span class="label" t-if="partner.vat">RNC/Céd</span>
                <input class="detail client-ref" name="vat" placeholder="RNC/Cédula" readonly="1" style="width:120px;background-color: #F0EEEE;" t-att-value="partner.vat" t-if="partner.vat"/>
                <input class="detail client-name" name="name" placeholder="Cédula, RNC o Nombre" style="width:50%;font-size: 14px;" t-att-value="partner.name" t-if="!partner.vat"/>
                <input class="detail client-name" name="name" placeholder="Cédula, RNC o Nombre" readonly="1" style="width:50%;font-size: 14px;background-color: #F0EEEE;" t-att-value="partner.name" t-if="partner.vat"/>
            </div>
        </t>
        <t t-jquery=".client-details-box" t-operation="replace">
            <div class="client-details-box clearfix">
                <div class="client-details-left">
                    <div class="client-detail">
                        <span class="label">Comprob.</span>
                        <select class="detail client-fiscal_position" name="property_account_position_id">
                            <t t-as="fiscal_position" t-foreach="widget.pos.fiscal_positions">
                                <option t-att-selected="partner.property_account_position_id ? ((fiscal_position.id === partner.property_account_position_id[0]) ? true : false) : false" t-att-value="fiscal_position.id">
                                    <t t-esc="fiscal_position.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="client-detail">
                        <span class="label">Calle</span>
                        <input class="detail client-address-street" name="street" placeholder="Street" t-att-value="partner.street"/>
                    </div>
                    <div class="client-detail">
                        <span class="label">Ciudad</span>
                        <input class="detail client-address-city" name="city" placeholder="City" t-att-value="partner.city"/>
                    </div>
                    <div class="client-detail">
                        <span class="label">Código</span>
                        <input class="detail barcode" name="barcode" t-att-value="partner.barcode || &quot;&quot;"/>
                    </div>
                </div>
                <div class="client-details-right">
                    <div class="client-detail">
                        <span class="label">Teléfono</span>
                        <input class="detail client-phone" name="phone" t-att-value="partner.phone || &quot;&quot;" type="tel"/>
                    </div>
                    <div class="client-detail">
                        <span class="label">Celular</span>
                        <input class="detail client-mobile" name="mobile" t-att-value="partner.mobile || &quot;&quot;" type="tel"/>
                    </div>
                    <div class="client-detail">
                        <span class="label">Email</span>
                        <input class="detail client-email" name="email" t-att-value="partner.email || &quot;&quot;" type="email"/>
                    </div>
                </div>
            </div>
        </t>
    </t>
    <t t-extend="ClientDetails">
        <t t-jquery="span.label:contains('Tax ID')" t-operation="replace">
            <span class="label">RNC/Céd</span>
        </t>
    </t>
    <t t-extend="PosTicket">
        <t t-jquery="t[t-esc='moment().format(\'L LT\')']" t-operation="replace"/>
        <t t-jquery="t[t-esc='order.name']" t-operation="replace">
            <div class="pos-center-align">
                <h2>
                    <t t-esc="order.pos.company.name"/>
                </h2>
            </div>
            <div class="header col-xs-12 company-info" t-attf-style="padding-bottom:0px; padding-left:0px; padding-right:0px;text-align: left;">
                <div class="mb8" style="font-size:12px !important; padding-bottom:2px;">
                    <div t-if="widget.pos.company.street or widget.pos.company.street2 or widget.pos.company.zip">
                        <span class="fa fa-map-marker fa-lg"/>
                        <span t-esc="widget.pos.company.street"/>
                        <span t-if="widget.pos.company.street and widget.pos.company.street2">,</span>
                        <span t-esc="widget.pos.company.street2"/>
                    </div>
                    <div t-if="widget.pos.company.city or widget.pos.company.country_id">
                        <span class="fa fa-map-marker fa-lg"/>
                        <span t-esc="widget.pos.company.city"/>
                    </div>
                    <div t-if="widget.pos.company.phone or widget.pos.company.fax">
                        <span class="fa fa-phone-square fa-lg"/>
                        <span t-esc="widget.pos.company.phone"/>
                        <span t-if="widget.pos.company.phone and widget.pos.company.fax">,</span>
                        <span t-if="widget.pos.company.fax">Fax:</span>
                        <span t-esc="widget.pos.company.fax"/>
                    </div>
                    <div t-if="widget.pos.company.email">
                        <span class="fa fa-envelope-square fa-lg"/>
                        <span t-esc="widget.pos.company.email"/>
                    </div>
                    <div t-if="widget.pos.company.website">
                        <span class="fa fa-globe fa-lg"/>
                        <span t-esc="widget.pos.company.website"/>
                    </div>
                    <div t-if="widget.pos.company.vat">
                        <span class="fa fa-building fa-lg">RNC:</span>
                        <span t-esc="widget.pos.company.vat"/>
                    </div>
                </div>
                <div t-attf-style="width:auto; float:left; padding-left:15px; padding-right:15px; padding-top:2px; padding-bottom:2px;">
                    <span class="fa fa-twitter-square fa-lg" style="padding-left:0px;" t-if="widget.pos.company.twitter"/>
                    <span t-esc="widget.pos.company.twitter"/>
                    <span class="fa fa-facebook-square fa-lg" style="padding-left:13px;" t-if="widget.pos.company.facebook"/>
                    <span t-esc="widget.pos.company.facebook"/>
                    <span class="fa fa-google-plus-square fa-lg" style="padding-left:13px;" t-if="widget.pos.company.googleplus"/>
                    <span t-esc="widget.pos.company.googleplus"/>
                </div>
            </div>
        </t>
        <t t-jquery="t[t-esc='widget.pos.company.name']" t-operation="replace">
            <div class="pos-center-align">
                <div class="pos-center-align">
                    <t t-esc="moment().format('L LT')"/>
                    <t t-esc="order.name"/>
                </div>
                <strong>
                    <span t-esc="order.fiscal_type_name"/>
                    <br/>
                    <span t-esc="order.ncf"/>
                    <br/>
                    <t t-if="order.origin_ncf">
                        <span>Afecta: </span>
                        <span t-esc="order.origin_ncf"/>
                    </t>
                </strong>
            </div>
            <br/>
            <t t-set="client" t-value="order.get('client')"/>
            <t t-if="client">
                <span>Cliente:</span>
                <t t-esc="client.name || ''"/>
                <br t-if="client.vat"/>
                <t t-if="client.vat">
                    <span>RNC:</span>
                    <t t-esc="client.vat"/>
                </t>
                <br t-if="client.address"/>
                <t t-if="client.address">
                    <span>Dirección:</span>
                    <t t-esc="client.address || ''"/>
                </t>
            </t>
        </t>
        <t t-jquery="t[t-esc*='widget.pos.company.phone']" t-operation="replace">
            <t t-if="client">
                <t t-esc="client.phone || ''"/>
            </t>
        </t>
        <t t-jquery="tr[t-foreach='orderlines']" t-operation="replace">
            <table class="table">
                <tr style="border-width: 2px;border-style: dotted;">
                    <th>Cant.</th>
                    <th>Desc.</th>
                    <th class="pos-right-align">Monto</th>
                </tr>
                <tr t-as="orderline" t-foreach="orderlines">
                    <td>
                        <t t-esc="orderline.get_quantity_str_with_unit()"/>
                    </td>
                    <td>
                        <t t-esc="orderline.get_product().display_name"/>
                        <t t-if="orderline.get_discount() > 0">
                            <div class="pos-disc-font">
                                <span>With a</span>
                                <t t-esc="orderline.get_discount()">% discount</t>
                            </div>
                        </t>
                    </td>
                    <td class="pos-right-align">
                        <t t-esc="widget.format_currency(orderline.get_display_price())"/>
                    </td>
                </tr>
            </table>
        </t>
    </t>
</templates>
