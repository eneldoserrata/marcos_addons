<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-extend="ClientDetailsEdit">
        <t t-jquery=".detail.client-name" t-operation="replace">
            <div class="client-detail">
                <span class="label" t-if="partner.vat">RNC/Céd</span>
                <input class="detail client-ref" name="vat" placeholder="RNC/Cédula" readonly="1" style="width:120px;background-color: #F0EEEE;" t-att-value="partner.vat" t-if="partner.vat"/>
                <input class="detail client-name" name="name" placeholder="Cédula, RNC o Nombre" style="width:50%;font-size: 14px;" t-att-value="partner.name" t-if="!partner.vat"/>
                <input class="detail client-name" name="name" placeholder="Cédula, RNC o Nombre" readonly="1" style="width:50%;font-size: 14px;background-color: #F0EEEE;" t-att-value="partner.name" t-if="partner.vat"/>
            </div>
        </t>
        <t t-jquery=".client-details-box" t-operation="replace">
            <div class="client-details-box clearfix">
                <div class="client-details-left">
                    <div class="client-detail">
                        <span class="label">Comprob.</span>
                        <select class="detail client-fiscal_position" name="property_account_position_id">
                            <t t-as="fiscal_position" t-foreach="widget.pos.fiscal_positions">
                                <option t-att-selected="partner.property_account_position_id ? ((fiscal_position.id === partner.property_account_position_id[0]) ? true : false) : false" t-att-value="fiscal_position.id">
                                    <t t-esc="fiscal_position.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>
            </div>
        </t>
    </t>
    <t t-extend="ClientDetails">
        <t t-jquery="span.label:contains('Tax ID')" t-operation="replace">
            <span class="label">RNC/Céd</span>
        </t>
    </t>
  <t t-extend="PosTicket">
    <t t-jquery=".pos-sale-ticket" t-operation="replace">
      <div class="pos-sale-ticket">
        <div>
          <strong><t t-esc="moment().format('L LT')"/></strong>
        </div>
        <br/>
        <div id="company-logo" align="center">
            <img t-att-src="receipt.company.logo" width="240px"/>
        </div>
        <br/>

        <div align="center">
            <t t-if="widget.pos.company">
               <t t-esc="widget.pos.company.name"/><br />
            </t>
            <t t-if="widget.pos.company.street">
               <t t-esc="widget.pos.company.street"/>,
            </t>
            <t t-if="widget.pos.company.street2">
               <t t-esc="widget.pos.company.street2"/>
            </t>
        </div>

        <div align="center">
          <t t-if="widget.pos.company.city">
            <t t-esc="widget.pos.company.city"/>
          </t>
        </div>

        <div align="center">
          <t t-if="widget.pos.company.phone">
            <strong>Tel:</strong><t t-esc="widget.pos.company.phone || ''" /><br />
          </t>
          <t t-if="widget.pos.company.vat">
            <strong>RNC:</strong><t t-esc="widget.pos.company.vat"/>
          </t>
       </div>

        <div align="center">
        </div>
        <br/>
        <div class="pos-center-align">
            <div class="pos-center-align">
                <t t-esc="order.name"/>
            </div>
            <strong>
                <strong><t t-esc="order.fiscal_type_name"/><br/></strong>
                <strong><t t-esc="order.ncf"/><br/></strong>
                <t t-if="order.origin_ncf">
                    <strong>Afecta: </strong><span t-esc="order.origin_ncf"/>
                </t>
            </strong>
        </div>
        <br/>
        <t t-set="client" t-value="order.get('client')"/>
        <t t-if="client">
            <strong>Cliente:</strong><t t-esc="client.name || ''"/>
            <br t-if="client.vat"/>
            <t t-if="client.vat">
                <strong>RNC:</strong><t t-esc="client.vat"/>
            </t>
        </t>
        <br/>
        <strong>Cajero(a):</strong><t t-esc="widget.pos.cashier ? widget.pos.cashier.name : widget.pos.user.name"/><br/>
        <strong>Sucursal:</strong><t t-esc="widget.pos.shop.name"/><br/>
        <br/>

        <div style="border-bottom: 2px solid black;"></div>
        <t t-if="receipt.header">
            <div style='text-align:center'>
                <t t-esc="receipt.header" />
            </div>
            <br/>
        </t>
        <table class='receipt-orderlines'>
            <thead>
              <tr>
                 <th width='40%'><strong>Producto</strong></th>
                 <th width='20%'><strong>Prec/Und</strong></th>
                 <th width='20%' class="pos-right-align"><strong>Cant.</strong></th>
                 <th width='20%' class="pos-right-align"><strong>Valor $</strong></th>
              </tr>
              </thead>
            <tr>
                <td><div style="border-bottom: 1px solid black;"></div></td>
                <td><div style="border-bottom: 1px solid black;"></div></td>
                <td><div style="border-bottom: 1px solid black;"></div></td>
                <td><div style="border-bottom: 1px solid black;"></div></td>
            </tr>
            <tr t-foreach="orderlines" t-as="orderline">
                <td width='40%'>
                    <t t-esc="orderline.get_product().display_name"/>
                     <t t-if="orderline.get_discount() > 0">
                        <div class="pos-disc-font">
                            With a <t t-esc="orderline.get_discount()"/>% discount
                        </div>
                    </t>
                </td>
                <td width='20%' class="pos-center-align">
                    <t t-esc="widget.format_currency_no_symbol(orderline.price)"/>
                </td>
                <td width='20%' class="pos-right-align">
                    <t t-esc="orderline.get_quantity_str_with_unit()"/>
                </td>
                <td width='20%' class="pos-right-align">
                    <t t-esc="widget.format_currency_no_symbol(orderline.get_display_price())"/>
                </td>
            </tr>
        </table>

        <table>
         <tr width='100%'>
            <br />
              <td width='50%' class="pos-left-align"></td>
              <td width='50%' class="pos-right-align">
                  <div style="border-bottom: 1px dashed black"></div>
              </td>
         </tr>
        </table>

        <table class='receipt-total'>
            <tr width='100%'>
                <td width='75%' class="pos-right-align">SubTotal:</td>
                <td width='25%' class="pos-right-align">
                    <t t-esc="widget.format_currency_no_symbol(order.get_total_without_tax())"/>
                </td>
            </tr>
            <t t-foreach="order.get_tax_details()" t-as="taxdetail">
                <tr>
                    <td width='75%' class="pos-right-align"><t t-esc="taxdetail.name"/>:</td>
                    <td width='25%'  class="pos-right-align">
                        <t t-esc="widget.format_currency_no_symbol(taxdetail.amount)"/>
                    </td>
                </tr>
            </t>
            <tr width='100%'>
                <td width='75%' class="pos-right-align">Descuento:</td>
                <td width='25%' class="pos-right-align">
                    <t t-esc="widget.format_currency_no_symbol(order.get_total_discount())"/>
                </td>
            </tr>
         </table>

         <table>
            <tr width='100%'>
             <td width='50%'>
             </td>
             <td width='50%'>
              <div style="border-bottom: 1px solid black;"></div>
             </td>
           </tr>
         </table>

         <table>
            <tr width='100%' class="emph">
                <td width='45%' class="pos-right-align">Total:</td>
                <td width='55%' class="pos-right-align">
                    <t t-esc="widget.format_currency(order.get_total_with_tax())"/>
                </td>
            </tr>
        </table>
        <br/>
        <table class='receipt-paymentlines'>
            <t t-foreach="paymentlines" t-as="line">
              <tr width='100%'>
                  <td width='75%' class="pos-right-align">
                      <t t-esc="line.name"/>:
                  </td>
                  <td width='25%' class="pos-right-align">
                      <t t-esc="widget.format_currency_no_symbol(line.get_amount())"/>
                  </td>
              </tr>
            </t>
        </table>

      <table class='receipt-change'>
          <tr width='100%'>
            <td width='75%' class="pos-right-align"><strong>Cambio:</strong></td>
            <td width='25%' class="pos-right-align">
              <t t-esc="widget.format_currency_no_symbol(order.get_change())"/>
            </td>
        </tr>
      </table>
      <br/>
      <div t-attf-style="width:auto; float:left; padding-left:15px; padding-right:15px; padding-top:2px; padding-bottom:2px;">
          <span  t-if="widget.pos.company.twitter" style="padding-left:0px;" class="fa fa-twitter-square fa-lg"/>&#160;
          <span  t-esc="widget.pos.company.twitter"/>
          <span  t-if="widget.pos.company.facebook" style="padding-left:13px;" class="fa fa-facebook-square fa-lg"/>&#160;
          <span  t-esc="widget.pos.company.facebook"/>
          <span  t-if="widget.pos.company.googleplus" style="padding-left:13px;" class="fa fa-google-plus-square fa-lg"/>&#160;
          <span  t-esc="widget.pos.company.googleplus"/>
      </div>
      <br/>
      <t t-if="receipt.footer">
        <br />
        <div style='text-align:center'>
            <t t-esc="receipt.footer" />
        </div>
        </t>
      </div>
    </t>
  </t>
</templates>
