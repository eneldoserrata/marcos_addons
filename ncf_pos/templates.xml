<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_backend" inherit_id="point_of_sale.assets">
        <xpath expr="." position="inside">
            <link href="/ncf_pos/static/src/css/ncf_pos.css" rel="stylesheet"/>
            <script src="/ncf_pos/static/src/js/models.js" type="text/javascript"/>
            <script src="/ncf_pos/static/src/js/screens.js" type="text/javascript"/>
        </xpath>
    </template>
    <template id="ncf_pos_receipt_inherit" inherit_id="point_of_sale.report_receipt">
        <xpath expr="//div[@class='col-xs-12 text-center']/br" position="after">RNC No.:
            <span t-field="o.invoice_id.number"/>
            <br/></xpath>
    </template>
</odoo>
