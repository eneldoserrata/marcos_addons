<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ncf_manager_account_invoice_form" model="ir.ui.view">
        <field name="name">ncf manager account invoice form</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_invoice_cancel']" position="replace">
                <button groups="account.group_account_user" name="%(account.action_account_invoice_cancel)d" states="draft,proforma2,open" string="Cancel Invoice" type="action"/>
            </xpath>
            <field name="journal_id" position="replace">
                <field groups="account.group_account_manager" name="move_name"/>
            </field>
            <field name="fiscal_position_id" position="replace"/>
            <field name="partner_id" position="after">
                <field attrs="{'required': True}" name="fiscal_position_id"/>
            </field>
            <field name="fiscal_position_id" position="attributes">
                <attribute name="domain">[('supplier','=',False)]</attribute>
                <attribute name="required">1</attribute>
            </field>
            <field name="user_id" position="after">
                <field attrs="{'readonly': [('state','!=','draft')]}" name="shop_id" options="{'no_quick_create': True, 'no_create_edit' : True}" required="1"/>
                <field invisible="1" name="ncf_control"/>
                <field attrs="{'invisible': [('ncf_control','=',False)], 'required': [('ncf_control','=',True)], 'readonly': [('state','!=','draft')]}" name="sale_fiscal_type"/>
                <field invisible="0" name="reference" readonly="1"/>
                <field groups="account.group_account_manager" invisible="0" name="move_name"/>
            </field>
            <field name="date_due" position="replace"/>
            <field name="date_invoice" position="after">
                <field attrs="{'required': True}" name="journal_id"/>
            </field>
            <field name="number" position="before">
                <label attrs="{'invisible': [('state','!=','cancel')]}" string="Cancelada por:"/>
                <field attrs="{'invisible': [('state','!=','cancel')]}" name="anulation_type" readonly="1"/>
                <field attrs="{'invisible': [('state','!=','cancel')]}" name="move_name" readonly="1"/>
            </field>
        </field>
    </record>
    <record id="ncf_manager_supplier_account_invoice_form" model="ir.ui.view">
        <field name="name">ncf manager supplier account invoice form</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_supplier_form"/>
        <field name="arch" type="xml">
            <field name="fiscal_position_id" position="replace"/>
            <field name="partner_id" position="replace">
                <field name="purchase_fiscal_type" readonly="1"/>
                <field attrs="{'readonly': [('purchase_fiscal_type','=','minor')]}" context="{'default_customer': 0, 'search_default_supplier': 1, 'default_supplier': 1}" domain="[('supplier', '=', True)]" name="partner_id" string="Proveedor"/>
                <field attrs="{'required': True}" name="fiscal_position_id"/>
                <field invisible="1" name="ncf_required"/>
            </field>
            <field name="fiscal_position_id" position="attributes">
                <attribute name="domain">[('supplier','=',True)]</attribute>
                <attribute name="required">1</attribute>
            </field>
            <field name="fiscal_position_id" position="after">
                <field attrs="{'required': True,'readonly': [('state','!=','draft')]}" name="expense_type"/>
            </field>
            <field name="journal_id" position="replace"/>
            <field name="date_due" position="after">
                <field attrs="{'readonly':[('move_name','!=',False)]}" groups="account.group_account_user" name="journal_id" options="{'no_create': True}"/>
            </field>
            <field name="move_name" position="replace"/>
            <field name="reference" position="before">
                <field attrs="{'size': 19,'invisible': [('purchase_fiscal_type','!=','normal')],'required': [('purchase_fiscal_type','=','normal')],'readonly': [('state','!=','draft')]}" name="move_name" string="NCF"/>
            </field>
        </field>
    </record>
</odoo>
