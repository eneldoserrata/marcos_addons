<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="ncf_manager_fiscal_position_form" model="ir.ui.view">
            <field name="name">ncf fiscal position manager</field>
            <field name="model">account.fiscal.position</field>
            <field name="inherit_id" ref="account.view_account_position_form"/>
            <field name="arch" type="xml">
                <field name="auto_apply" position="before">
                    <field name="supplier"/>
                    <field attrs="{'invisible':[('supplier','=',True)]}" name="client_fiscal_type"/>
                    <field attrs="{'invisible':[('supplier','!=',True)]}" name="journal_id"/>
                </field>
                <xpath expr="//tree//field[@name='tax_dest_id']" position="replace">
                    <field domain="[('type_tax_use', '!=', None)]" name="tax_dest_id"/>
                </xpath>
                <xpath expr="//form//field[@name='tax_dest_id']" position="replace">
                    <field domain="[('type_tax_use', '!=', None)]" name="tax_dest_id"/>
                </xpath>
            </field>
        </record>
        <record id="ncf_manager_account_journal_form" model="ir.ui.view">
            <field name="name">ncf manager aacount journal form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field attrs="{'invisible': [('type','!=','sale')]}" name="ncf_control"/>
                    <field attrs="{'invisible': [('type','!=','purchase')]}" name="purchase_type" widget="radio"/>
                    <field attrs="{'invisible': [('type','!=','purchase')]}" name="ncf_remote_validation"/>
                </field>
                <field name="code" position="replace">
                    <field attrs="{'readonly': ['|',('type', 'in', ['bank','cash'])], 'required': [('type', 'not in', ['bank', 'cash'])]}" name="code"/>
                </field>
                <field name="refund_sequence_id" position="replace"/>
                <xpath expr="//page[@name='journal_entries']" position="inside">
                    <group attrs="{'invisible':[('type','!=','sale')]}">
                        <field attrs="{'invisible': [('ncf_control','!=',True)]}" name="final_sequence_id"/>
                        <field attrs="{'invisible': [('ncf_control','!=',True)]}" name="fiscal_sequence_id"/>
                        <field attrs="{'invisible': [('ncf_control','!=',True)]}" name="gov_sequence_id"/>
                        <field attrs="{'invisible': [('ncf_control','!=',True)]}" name="special_sequence_id"/>
                        <field attrs="{'invisible': [('ncf_control','!=',True)]}" name="unique_sequence_id"/>
                        <field attrs="{'invisible': ['|',('type', 'not in', ['sale', 'purchase']), ('refund_sequence', '!=', True)]}" name="refund_sequence_id" required="0" string="Secuencia para Notas de Crédito"/>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="ncf_manager_account_tax_form" model="ir.ui.view">
            <field name="name">ncf manager account tax form</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_tax_form"/>
            <field name="arch" type="xml">
                <field name="type_tax_use" position="after">
                    <field attrs="{'invisible': [('type_tax_use','!=','purchase')]}" name="purchase_tax_type" widget="radio"/>
                </field>
            </field>
        </record>
        <!-- This Menu Item must have a parent and an action -->
        <!-- Inherit Form View to Modify it -->
        <record id="inherit_view_account_type_form" model="ir.ui.view">
            <field name="name">inherit_view_account_type_form</field>
            <field name="model">account.account.type</field>
            <field name="inherit_id" ref="account.view_account_type_form"/>
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="include_initial_balance"/>
                </field>
            </field>
        </record>
        <menuitem action="account.action_account_type_form" id="action_account_type_form_menu" name="Tipos de cuentas" parent="account.account_management_menu" sequence=""/>
        <!-- Inherit Form View to Modify it -->
        <record id="ncf_manager_view_account_bnk_stmt_cashbox" model="ir.ui.view">
            <field name="name">ncf_manager_view_account_bnk_stmt_cashbox</field>
            <field name="model">account.bank.statement.cashbox</field>
            <field name="inherit_id" ref="account.view_account_bnk_stmt_cashbox"/>
            <field name="arch" type="xml">
                <tree position="replace">
                    <tree editable="bottom">
                        <field name="number"/>
                        <field name="coin_value"/>
                        <field name="subtotal" sum="Total"/>
                    </tree>
                </tree>
            </field>
        </record>
        <record id="ncf_manager_account_payment_method_form" model="ir.ui.view">
            <field name="name">ncf_manager_account_payment_method_form</field>
            <field name="model">account.payment.method</field>
            <field name="arch" type="xml">
                <form string="Tipo de pagos en diarios">
                    <sheet>
                        <group>
                            <field groups="base.group_no_one" name="code"/>
                            <field name="name"/>
                            <field name="payment_type"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ncf_manager_account_payment_method_action" model="ir.actions.act_window">
            <field name="name">Tipo de pagos en diarios</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.payment.method</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>
        <!-- This Menu Item must have a parent and an action -->
        <menuitem action="ncf_manager_account_payment_method_action" id="UNIQUE_ID_categ" name="Tipo de pagos en diarios" parent="account.account_account_menu" sequence=""/>
        <!-- Inherit Form View to Modify it -->
        <record id="ncf_manager_view_account_move_line_filter" model="ir.ui.view">
            <field name="name">ncf_manager_view_account_move_line_filter</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_account_move_line_filter"/>
            <field name="arch" type="xml">
                <field name="date" position="after">
                    <field name="debit"/>
                    <field name="credit"/>
                </field>
            </field>
        </record>
    </data>
</openerp>
