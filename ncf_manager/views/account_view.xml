<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ncf_manager_fiscal_position_form" model="ir.ui.view">
        <field name="name">ncf fiscal position manager</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <field name="auto_apply" position="before">
                <field name="supplier"/>
                <field attrs="{'invisible':[('supplier','=',True)]}" name="sale_fiscal_type"/>
                <field attrs="{'invisible':[('supplier','!=',True)]}" name="journal_id"/>
            </field>
            <xpath expr="//tree//field[@name='tax_dest_id']" position="replace">
                <field domain="[('type_tax_use', '!=', None)]" name="tax_dest_id"/>
            </xpath>
            <xpath expr="//form//field[@name='tax_dest_id']" position="replace">
                <field domain="[('type_tax_use', '!=', None)]" name="tax_dest_id"/>
            </xpath>
        </field>
    </record>
    <record id="ncf_manager_account_journal_form" model="ir.ui.view">
        <field name="name">ncf manager account journal form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field attrs="{'invisible': [('type','!=','sale')]}" name="ncf_control"/>
                <field attrs="{'invisible': [('type','!=','purchase')]}" name="purchase_type" widget="radio"/>
                <field attrs="{'invisible': [('type','!=','purchase')]}" name="ncf_remote_validation"/>
            </field>
            <field name="code" position="replace">
                <field attrs="{'readonly': ['|',('type', 'in', ['bank','cash'])], 'required': [('type', 'not in', ['bank', 'cash'])]}" name="code"/>
            </field>
        </field>
    </record>
    <record id="ncf_manager_account_tax_form" model="ir.ui.view">
        <field name="name">ncf manager account tax form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="type_tax_use" position="after">
                <field attrs="{'invisible': [('type_tax_use','!=','purchase')]}" name="purchase_tax_type" widget="radio"/>
            </field>
        </field>
    </record>
    <menuitem groups="account.group_account_user" id="marcos_account_dgii_menu" name="DGII" parent="account.menu_finance" sequence="5"/>
    <menuitem id="marcos_account_dgii_file_menu" name="Archivos" parent="marcos_account_dgii_menu" sequence="5"/>
</odoo>
